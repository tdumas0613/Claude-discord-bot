auth {
  mode: none
}

script:pre-request {
  const crypto = require('crypto');
  
  // Every request in this collection is signed the way Discord signs its own:
  // Ed25519 over `timestamp + rawBody`, in `x-signature-ed25519`, with the
  // timestamp alongside it. `src/lambda/responder/signature.ts` verifies it.
  //
  // The body is serialized here and written straight back, so the bytes signed
  // are the bytes sent. Verification is over the RAW body — if Bruno
  // re-serialized it on the way out, every request would fail with a 401 that
  // looked like a key problem.
  // {{placeholders}} are resolved here rather than left to Bruno. Whether it
  // interpolates before or after this script, the bytes signed below are then
  // the bytes sent: if it happened afterwards we would have signed the literal
  // {{...}} text, and if it happened already this is a no-op.
  const interpolate = (text) =>
    text.replace(/\{\{([^}]+)\}\}/g, (whole, name) => {
      const key = name.trim();
      const value = bru.getEnvVar(key) ?? bru.getVar(key);
      return value === undefined || value === null ? whole : String(value);
    });
  
  const body = req.getBody();
  const rawBody = interpolate(typeof body === 'string' ? body : JSON.stringify(body ?? {}));
  req.setBody(rawBody);
  
  // Requests that exercise the replay window say how far to backdate. The
  // responder ignores headers it does not know, so this one is left in place.
  const headers = req.getHeaders() || {};
  const backdate = Number(headers['x-test-backdate-seconds'] ?? 0) || 0;
  const timestamp = String(Math.floor(Date.now() / 1000) - backdate);
  
  const seed = bru.getEnvVar('testPrivateKeyHex');
  if (!seed) {
    // Left unsigned rather than failing here: the "rejects" requests are still
    // meaningful without a key, and they are the ones worth running first.
    console.log('testPrivateKeyHex is not set — sending unsigned. See the collection README.');
  } else {
    // Node wants a PKCS#8 wrapper around the raw 32-byte seed.
    const der = Buffer.concat([
      Buffer.from('302e020100300506032b657004220420', 'hex'),
      Buffer.from(seed, 'hex'),
    ]);
    const key = crypto.createPrivateKey({ key: der, format: 'der', type: 'pkcs8' });
    const signature = crypto.sign(null, Buffer.from(timestamp + rawBody), key).toString('hex');
  
    req.setHeader('x-signature-ed25519', signature);
    req.setHeader('x-signature-timestamp', timestamp);
  }
}
