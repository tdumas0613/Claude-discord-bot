meta {
  name: 02 - Roast command
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"type":2,"token":"bruno-test-token","application_id":"{{applicationId}}","data":{"name":"roast","options":[{"name":"user","type":6,"value":"{{targetUserId}}"}],"resolved":{"users":{"{{targetUserId}}":{"id":"{{targetUserId}}","username":"{{targetDisplayName}}","global_name":"{{targetDisplayName}}"}},"members":{"{{targetUserId}}":{"nick":null}}}}}
}

assert {
  res.status: eq 200
  res.body.type: eq 5
}

docs {
  A full `/roast` interaction. A type-5 response means the responder verified
  the signature, recognized the command, and handed it to the worker — which
  is everything the responder is responsible for.
  
  The worker then fails, and that is expected: `bruno-test-token` is not a real
  interaction token, so its follow-up to Discord is rejected. Watch that part
  in the worker's CloudWatch log group, or in the dead-letter queue the deploy
  prints as WorkerFailureQueueUrl. Only a real interaction from Discord can
  produce a reply that lands in a channel.
}
