# Discord bot token — Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Anthropic API key — https://console.anthropic.com/settings/keys
# Used directly when running locally. On Lambda the worker reads it from
# Secrets Manager instead; see ANTHROPIC_SECRET_ID below.
ANTHROPIC_API_KEY=

# Application ID — Discord Developer Portal > your app > General Information.
# Needed by `npm run register` and by the Lambda responder.
DISCORD_CLIENT_ID=

# Public Key — Discord Developer Portal > your app > General Information.
# Only needed when running on Lambda: it verifies that interaction requests
# really came from Discord. Not a secret, but it must match the application.
DISCORD_PUBLIC_KEY=

# Optional. Set to a server ID to register /roast to that server only, which
# updates instantly instead of taking up to an hour to propagate globally.
DISCORD_GUILD_ID=

# --- Lambda only -----------------------------------------------------------
# Set by CDK on the deployed worker, not by you: the Secrets Manager secret
# holding the Anthropic key. An ANTHROPIC_API_KEY set here always wins, so
# local runs never reach for AWS.
# ANTHROPIC_SECRET_ID=

# Optional, for `cdk deploy`. Defaults to
# claude-discord-roast-bot/anthropic-api-key.
# ANTHROPIC_SECRET_NAME=
